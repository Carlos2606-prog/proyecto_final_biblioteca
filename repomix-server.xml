package co.edu.uptc.controller;

import co.edu.uptc.model.LibraryManager;
import co.edu.uptc.pojo.Observer;
import co.edu.uptc.persistence.LocalDateAdapter;
import com.google.gson.Gson;
import com.google.gson.GsonBuilder;

import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.IOException;
import java.net.Socket;
import java.time.LocalDate;

public class ClientHandler implements Runnable, Observer {
    private Socket socket;
    private LibraryManager libraryManager;
    private DataInputStream in;
    private DataOutputStream out;

    public ClientHandler(Socket socket, LibraryManager libraryManager) {
        this.socket = socket;
        this.libraryManager = libraryManager;
    }

    @Override
    public void run() {
        try {
            in = new DataInputStream(socket.getInputStream());
            out = new DataOutputStream(socket.getOutputStream());

            libraryManager.attach(this);

            while (true) {
                String request = in.readUTF();
                String response = processRequest(request);
                synchronized (out) {
                    out.writeUTF(response);
                }
            }
        } catch (IOException e) {
            System.out.println("Cliente desconectado: " + socket.getInetAddress());
        } finally {
            libraryManager.detach(this);
            try {
                if (socket != null)
                    socket.close();
            } catch (IOException e) {
                e.printStackTrace();
            }
        }
    }

    @Override
    public void update() {
        try {
            if (out != null) {
                synchronized (out) {
                    // El cliente debe interpretar esta trama genérica y
                    // volver a consultar los datos (ej. enviando un GET_ALL)
                    out.writeUTF("NOTIFICATION;DATA_CHANGED");
                }
            }
        } catch (IOException e) {
            System.err.println("Error enviando notificación: " + e.getMessage());
        }
    }

    private String processRequest(String request) {
        String[] parts = request.split(";");
        String command = parts[0];

        // Instanciar Gson incluyendo el adaptador de fechas
        Gson gson = new GsonBuilder()
                .registerTypeAdapter(LocalDate.class, new LocalDateAdapter())
                .create();

        try {
            switch (command) {
                // ==========================================
                // VALIDACIÓN DE LOGIN (Administrador y Usuario)
                // ==========================================
                case "LOGIN_ADMIN":
                    // parts[1] es el usuario y parts[2] es la contraseña
                    if ("admin".equals(parts[1]) && "123".equals(parts[2])) {
                        return "SUCCESS";
                    } else {
                        return "ERROR;Credenciales incorrectas";
                    }

                case "LOGIN_USER":
                    // parts[1] es el userId, parts[2] es el nombre
                    co.edu.uptc.model.User user = libraryManager.findUserById(parts[1]);
                    if (user != null && user.getName().equals(parts[2])) {
                        return "SUCCESS";
                    } else {
                        return "ERROR;Usuario no encontrado o datos incorrectos";
                    }

                // ==========================================
                // GESTIÓN DE USUARIOS
                // ==========================================
                case "GET_USERS":
                    return "SUCCESS;" + gson.toJson(libraryManager.getAllUsers());

                case "ADD_USER":
                    libraryManager.addUser(parts[1], parts[2], parts[3]);
                    return "SUCCESS;Usuario agregado correctamente";

                // ==========================================
                // GESTIÓN DE LIBROS
                // ==========================================
                case "GET_BOOKS":
                    return "SUCCESS;" + gson.toJson(libraryManager.getAllBooks());

                case "ADD_BOOK":
                    // ADD_BOOK;code;title;author;genre;year;numCopies
                    int code = Integer.parseInt(parts[1]);
                    String title = parts[2];
                    String author = parts[3];
                    String genre = parts[4];
                    int year = Integer.parseInt(parts[5]);
                    int numCopies = Integer.parseInt(parts[6]);
                    
                    libraryManager.addBook(code, title, author, genre, year, numCopies);
                    return "SUCCESS;Libro agregado correctamente";

                // ==========================================
                // GESTIÓN DE PRÉSTAMOS
                // ==========================================
                case "GET_LOANS":
                    return "SUCCESS;" + gson.toJson(libraryManager.getAllLoans());

                default:
                    return "ERROR;Comando no reconocido";
            }
        } catch (Exception e) {
            return "ERROR;" + e.getMessage();
        }
    }
}
