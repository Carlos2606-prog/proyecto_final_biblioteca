public class BinaryTree<T> {

    private DoubleNode<T> root;
    private Comparator<T> comparator;

    public BinaryTree(Comparator<T> comparator) {
        this.comparator = comparator;
    }

    public boolean add(T value) {
        if (root == null) {
            root = new DoubleNode<>(value);
            return true;
        }
        return add(value, root);
    }

    private boolean add(T value, DoubleNode<T> subRoot) {
        int cmp = comparator.compare(value, subRoot.getValue());
        if (cmp == 0) {
            return false;
        }
        if (cmp < 0) {
            if (subRoot.getLeft() == null) {
                subRoot.setLeft(new DoubleNode<>(value));
                return true;
            }
            return add(value, subRoot.getLeft());
        }

        if (subRoot.getRight() == null) {
            subRoot.setRight(new DoubleNode<>(value));
            return true;
        }
        return add(value, subRoot.getRight());
    }

    public boolean remove(T value) {
        return remove(value, root);
    }

