            .create();
    }
    
    public <T> void writeList(String path, List<T> data) throws IOException {
        File file = new File(path);
        file.getParentFile().mkdirs();
        
        try (FileWriter writer = new FileWriter(file)) {
            gson.toJson(data, writer);
        }
    }
}
